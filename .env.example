# Port server NestJS
PORT=4000

# CORS Allowed Origin (Next.js Frontend)
CORS_ORIGIN=http://localhost:3000

# Supabase PostgreSQL Connection String
# 1. DATABASE_URL: Gunakan connection pooler Supabase (Port 6543)
# 2. DIRECT_URL: Gunakan koneksi langsung Supabase (Port 5432) untuk migrasi Prisma
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/portfolio_db?schema=public"

# JWT Secret untuk otentikasi Admin CMS
JWT_SECRET="super-secret-jwt-key-ilham-portfolio-2026"
JWT_EXPIRES_IN="7d"

# Default Admin credentials for seeding
ADMIN_EMAIL="admin@ilham.dev"
ADMIN_PASSWORD="AdminPassword2026!"

